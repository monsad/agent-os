# Ollama (OpenAI-compatible)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gpt-oss:20b

# Ghost (ghost.build) Postgres connection string.
# Optional: leave empty to run without the structured store — the dashboard still
# renders and chats; goals/journal/Ghost-search routes just return empty results.
GHOST_DATABASE_URL=postgres://user:pass@host:5432/dbname

# graphify. Chat turns are written here, so point this at an absolute path
# OUTSIDE the repo — otherwise your conversations sit in the working tree and
# can be swept into a commit. (graphify skips gitignored files, so ignoring the
# in-repo default would just leave the graph empty.)
GRAPHIFY_NOTES_DIR=/absolute/path/to/agent-os-notes

# Per-user auth. Users register/log in at /login; goals are scoped to the signed-in
# user. AGENT_OS_SESSION_SECRET is the HMAC key used to sign session cookies — set it
# to a long random string in real use (a default is used only for local dev).
AGENT_OS_SESSION_SECRET=
