# Ollama (OpenAI-compatible)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gpt-oss:20b

# Ghost (ghost.build) Postgres connection string.
# Optional: leave empty to run without the structured store — the dashboard still
# renders and chats; goals/journal/Ghost-search routes just return empty results.
GHOST_DATABASE_URL=postgres://user:pass@host:5432/dbname

# graphify
GRAPHIFY_NOTES_DIR=./data/notes

# Access gate. Set AGENT_OS_PASSCODE to require a passcode at /login before the
# dashboard or any API route is reachable. Leave empty to run open (local dev).
# AGENT_OS_SESSION_TOKEN is the opaque cookie value issued on success — set it to
# a long random string in real use.
AGENT_OS_PASSCODE=
AGENT_OS_SESSION_TOKEN=
